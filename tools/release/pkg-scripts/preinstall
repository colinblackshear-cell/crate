#!/bin/bash
# Runs as root before the Kaleidobox installer copies its files.
# Kaleidobox used to be called Crate Rig and shares its plugin codes, so old copies must go,
# and so must copies in the user's own Library (from the Terminal install) to avoid doubles.
USER_NAME="$(stat -f%Su /dev/console 2>/dev/null || echo "")"
USER_HOME=""
[ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ] && USER_HOME="$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"

osascript -e 'quit app "Kaleidobox"' >/dev/null 2>&1 || true
osascript -e 'quit app "Crate Rig"' >/dev/null 2>&1 || true

for base in "" "$USER_HOME"; do
    rm -rf "$base/Applications/Crate Rig.app"
    rm -rf "$base/Library/Audio/Plug-Ins/Components/Crate Rig.component"
    rm -rf "$base/Library/Audio/Plug-Ins/VST3/Crate Rig.vst3"
done
if [ -n "$USER_HOME" ]; then
    rm -rf "$USER_HOME/Applications/Kaleidobox.app"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/Kaleidobox.component"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/Kaleidobox.vst3"
    rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/Kaleidobox Input.component"
    # The tools on their own tracks (Kaleidobox Bass, Synth and Drums were once plugins of their own,
    # with the same codes: an old copy in your Library would show up twice in Logic).
    for t in MPC Bass Synth Drums Vocoder; do
        rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/Kaleidobox $t.component"
        rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/Kaleidobox $t.vst3"
    done
fi
exit 0
