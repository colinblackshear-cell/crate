#!/bin/bash
# Runs as root after the files are in place: clear any "downloaded" flag and make Logic see
# the new Audio Unit without restarting the Mac.
xattr -cr "/Applications/Kaleidobox.app" 2>/dev/null || true
xattr -cr "/Library/Audio/Plug-Ins/Components/Kaleidobox.component" 2>/dev/null || true
xattr -cr "/Library/Audio/Plug-Ins/VST3/Kaleidobox.vst3" 2>/dev/null || true
xattr -cr "/Library/Audio/Plug-Ins/Components/Kaleidobox Input.component" 2>/dev/null || true
for t in MPC Bass Synth Drums Vocoder; do
    xattr -cr "/Library/Audio/Plug-Ins/Components/Kaleidobox $t.component" 2>/dev/null || true
    xattr -cr "/Library/Audio/Plug-Ins/VST3/Kaleidobox $t.vst3" 2>/dev/null || true
done
killall -9 AudioComponentRegistrar >/dev/null 2>&1 || true
exit 0
