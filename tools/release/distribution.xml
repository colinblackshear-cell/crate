<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Kaleidobox</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="kaleidobox"/>
    </choices-outline>
    <choice id="kaleidobox" title="Kaleidobox">
        <pkg-ref id="com.colinblackshear.kaleidobox.pkg"/>
    </choice>
    <pkg-ref id="com.colinblackshear.kaleidobox.pkg" version="{{VERSION}}" onConclusion="none">kaleidobox-core.pkg</pkg-ref>
</installer-gui-script>
